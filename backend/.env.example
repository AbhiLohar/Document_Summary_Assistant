# Document Summary Assistant - Environment Configuration

# Google Gemini API Key (Get a free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Maximum upload file size in Megabytes (default: 25MB)
MAX_FILE_SIZE_MB=25

# Optional custom path to Tesseract OCR executable (if installed in non-standard path)
# e.g., Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# e.g., Linux: /usr/bin/tesseract
TESSERACT_CMD=

# AI Model Selection (e.g. gemini-1.5-flash, gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# Backend Host and Port
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated or * for development)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

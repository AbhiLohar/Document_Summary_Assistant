# ==============================================================================
# Document Summary Assistant - Environment Configuration
# ==============================================================================

# Google Gemini API Key (Get a free API key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Maximum upload file size in Megabytes (default: 25MB)
MAX_FILE_SIZE_MB=25

# Optional custom path to Tesseract OCR binary (auto-discovered if in standard PATH)
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux: /usr/bin/tesseract
# Mac: /opt/homebrew/bin/tesseract
TESSERACT_CMD=

# AI Model Selection (gemini-1.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
